# Server-only configuration. Never put a private key in NEXT_PUBLIC_* variables.
FIREBASE_PROJECT_ID=cs-class-f74c4
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=cs-class-f74c4.firebaseapp.com
# Use ADC locally, or the JSON service account as one secret in the hosting environment.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local alternative: absolute path outside this repository; never upload the file.
GOOGLE_APPLICATION_CREDENTIALS=
CS_TEACHER_EMAILS=
CS_INITIAL_PASSWORD=
CS_RESET_PASSWORD=
# Production cron bearer secret: generate a random value of at least 32 characters.
CRON_SECRET=
# Review-only AI, server-side Production Sensitive variables. Never NEXT_PUBLIC_*.
UPSTAGE_API_KEY=
# Random secret of at least 32 characters, used to sign interpreted sandwich commands.
CS_AI_COMMAND_SECRET=
# Set 1 to pause AI requests while preserving work and submissions.
CS_AI_PAUSED=0
# Explicit local testing only. Never set these on a deployed server.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
