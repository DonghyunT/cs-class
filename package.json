{
  "name": "cs-class",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-entryjs.mjs",
    "predev": "node scripts/prepare-entryjs.mjs",
    "prebuild": "node scripts/prepare-entryjs.mjs",
    "prepare:entryjs": "node scripts/prepare-entryjs.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:review": "node tests/review-engines.test.mjs && node tests/review-ai-protocol.test.mjs && node tests/review-flow-runner.test.mjs && node tests/review-rollout.test.mjs",
    "test": "playwright test",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-cs-class \"playwright test\"",
    "test:e2e:running": "playwright test",
    "dev:emulator": "firebase emulators:exec --only auth,firestore --project demo-cs-class \"node scripts/dev-emulator.mjs\"",
    "test:scope": "node --test tests/ci-policy.test.mjs tests/e2e-scope.test.mjs",
    "test:e2e:scope": "node scripts/run-selected-e2e.mjs",
    "test:e2e:scope:running": "node scripts/run-selected-e2e.mjs --running"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "15.31.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
