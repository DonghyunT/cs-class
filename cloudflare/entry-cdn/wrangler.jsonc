// Static-only Worker for the Entry vendor files (docs/plans/entry-assets-cloudflare.md).
// No `main` script: every request is a static asset request, which the Workers Free plan does not count or bill.
// Build the folder first with `node scripts/entryjs-cdn.mjs bundle`; `npm run deploy:entry-cdn` does both.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cs-class-entry",
  // No later than the pinned wrangler's workerd (1.20261019.1) supports, so `wrangler dev` can serve it locally.
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "../../scratch/entry-cdn",
    "not_found_handling": "none"
  }
}
